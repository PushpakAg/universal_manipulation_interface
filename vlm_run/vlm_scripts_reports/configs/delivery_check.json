{
  "_comment": "Thresholds for scripts/check_delivery.py, from DataPRD1019 v1.1 section 6 (UMI) and docs/UMI_delivery_checklist.md. Relative paths resolve against vlm_scripts_reports/.",
  "source": "s3://prod-mono-pipeline-v2-data/umi_data/industrial_data_mp4/",
  "region": null,
  "suffixes": {
    "head": "_head.mp4",
    "left": "_left.mp4",
    "right": "_right.mp4",
    "meta": "_meta.json",
    "right_gripper": "_right_gripper.csv",
    "left_gripper": "_left_gripper.csv",
    "mosaic": "_mosaic.mp4",
    "vlm": "_vlm_result.json"
  },
  "video_codecs": ["hevc", "h264"],
  "expected_fps": 59.94,
  "_expected_fps_note": "GoPro HERO12 at 59.94 fps; a different rate is a WARN, unequal rates between the three views (or vs meta) a FAIL (V1).",
  "fps_tolerance": 0.01,
  "max_frame_count_diff": 1,
  "max_duration_diff_frames": 1,
  "camera_keys_required": ["model", "resolution", "frame_rate_hz", "intrinsics_model", "fx", "fy", "cx", "cy"],
  "camera_lens_keys_any": ["lens", "fov_horizontal_deg", "fov_vertical_deg", "fov_diagonal_deg"],
  "kannala_brandt_keys": ["k1", "k2", "k3", "k4"],
  "gripper_width_m": [0.0, 0.15],
  "gripper_rows_tolerance": 1,
  "gripper_active_range_m": 0.02,
  "min_cycles": 3,
  "target_cycles": 5,
  "cycle_s": [3, 30],
  "vlm_fail_confidence": 0.8,
  "_vlm_note": "A VLM count below min_cycles fails the recording only with n_repetitions_confidence >= vlm_fail_confidence; otherwise REVIEW. A manual count always decides.",
  "manual_counts": "reports/manual_counts.csv",
  "setup_task_regex": "calibrat|inspect|\\btest|\\bscan|no manipulation",
  "workers": 16,
  "out_csv": "reports/delivery_check.csv",
  "out_summary_csv": "reports/delivery_check_summary.csv"
}
