# Copy to .env (git-ignored). Values already set in the shell win over this file.
# Local laptop: SSO profile (refresh with: aws sso login --profile prod).
# EC2 instance with an IAM role: leave AWS_PROFILE empty; the role's credentials are used.
AWS_PROFILE=prod
AWS_DEFAULT_REGION=

# Model keys. If left empty here, run_vlm_repetitions.py falls back to vlm_run/.env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
